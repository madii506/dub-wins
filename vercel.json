{
  "cleanUrls": true,
  "functions": {
    "api/tick.js": { "maxDuration": 60 },
    "api/dub.js": { "maxDuration": 25 }
  },
  "crons": [{ "path": "/api/tick", "schedule": "* * * * *" }],
  "rewrites": [
    { "source": "/api/:op(state|board|lookup|register|verify|me|days)", "destination": "/api/dub?op=:op" }
  ],
  "headers": [
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/assets/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, must-revalidate" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
